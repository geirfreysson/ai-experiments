```{=html}
<div class="list">
<% items.forEach((item, idx) => { %>
    <% const number = String(items.length - idx).padStart(2, '0'); %>
    <div class="listing-row" data-categories="<%= item.categories %>">
        <span class="listing-meta-line">
            <span class="listing-number">Note #<%= number %></span>
            <span class="listing-date">- <%= item.date %></span>
        </span>
        <% if (item.categories && item.categories.length) { %>
        <span class="listing-tags">
        <% item.categories.forEach((cat, i) => { %><% if (i > 0) { %><span class="tag-dot">&bull;</span><% } %><a href="#category=<%= encodeURIComponent(cat) %>" class="tag-link" data-category="<%= cat %>"><%= cat %></a><% }); %>
        </span>
        <% } %>
        <a href="<%= item.path %>" class="listing-title-link">
            <span class="listing-title"><%= item.title %></span>
        </a>
    </div>
<% }); %>
</div>
```
